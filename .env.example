# openGym base URL (the web container; /api is proxied to the API)
OG_URL=http://127.0.0.1:31180

# Public base URL of the same app, reachable from the internet: Discord fetches the exercise
# picture from ITS servers. Unset = OG_URL (only works for a public instance).
OG_PUBLIC=

# Your user id: data/state-<UID>.json, or `id` in data/db.json
OG_UID=

# Hex contents of data/secret (the key the API signs session cookies with)
OG_SECRET=

# Only if you ever pressed "sign out everywhere": the account's `sv` in data/db.json
OG_SV=0

# Discord application
DISCORD_CLIENT_ID=
DISCORD_ASSET=opengym

# Seconds between polls. The client heartbeats every 20 s and a row expires after 70 s.
POLL=20
